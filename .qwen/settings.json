{
  "permissions": {
    "allow": [
      "Bash(c:\\tools\\engram\\engram.exe *)",
      "Bash(npx *)",
      "WebFetch(openrouter.ai)",
      "WebSearch",
      "Bash(curl *)",
      "Bash(node *)",
      "Bash(npm run *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(powershell *)",
